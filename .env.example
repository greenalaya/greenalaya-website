# Supabase (required for data and the contact form)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: scripts (apply-phase4.mjs, update-butterfly-db-url.mjs) — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email via Resend: alerts staff on contact form submissions, and is
# required for the /membership form (it has no database — a submission's
# only destination is this email, with the applicant's documents attached)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_NOTIFY_EMAIL=info@greenalayanepal.org.np
CONTACT_FROM_EMAIL=Greenalaya Nepal <onboarding@resend.dev>
